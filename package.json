{
  "name": "meta-automation",
  "version": "2.0.0",
  "description": "End-to-end agentic automation runtime that learns a user's identity and business context, reasons over live browser state, executes verified actions, and safely operates across social and work workflows.",
  "main": "threads-agent.js",
  "bin": {
    "meta-automation": "./threads-agent.js"
  },
  "scripts": {
    "test": "node tests/suite.js && node tests/cross-platform-audit.js && node tests/job-engine-audit.js && node tests/desktop-runner.test.js",
    "e2e:browser": "node tests/browser-e2e.js",
    "onboard": "node threads-agent.js onboard",
    "configure": "node threads-agent.js onboard",
    "start": "node scripts/desktop-runner.js",
    "start:social": "node agentic-social.js",
    "auth": "node threads-agent.js auth",
    "scan": "node threads-agent.js scan",
    "analyze": "node threads-agent.js analyze",
    "approve": "node threads-agent.js approve",
    "status": "node threads-agent.js status",
    "build:release": "bash ./scripts/package-release.sh",
    "jobs:setup": "node scripts/setup-job-engine.js",
    "jobs:auth": "node job-agent.js auth",
    "jobs:profile": "node job-agent.js profile",
    "jobs:scan": "node job-agent.js scan",
    "jobs:run": "node job-agent.js run",
    "jobs:status": "node job-agent.js status",
    "jobs:google": "node job-agent.js google",
    "desktop:layout": "node scripts/layout-cdp-windows.js",
    "agentic:social": "node agentic-social.js",
    "test:agentic": "node tests/agentic-v2.test.js && node tests/onboarding-v2.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunmughan/meta-automation.git"
  },
  "keywords": [
    "agentic-automation",
    "browser-agent",
    "browser-automation",
    "ai-agent",
    "autonomous-agents",
    "cdp",
    "live-dom",
    "semantic-browser",
    "social-agent",
    "lead-generation",
    "workflow-automation",
    "relationship-intelligence",
    "job-automation",
    "codeair"
  ],
  "author": "Sunmughan Swamy <contact@codeair.tech> (https://www.codeair.tech)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sunmughan/meta-automation/issues"
  },
  "homepage": "https://github.com/sunmughan/meta-automation#readme",
  "type": "commonjs",
  "dependencies": {
    "puppeteer-core": "^25.11.0",
    "pdf-parse": "^1.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
