# Threads AI Lead Generation + Engagement Agent
# Configuration Template

# AI Runtime Configuration
# Supported providers: antigravity | minimax
AI_PROVIDER=minimax
AI_RUNTIME=minimax
AI_MODEL=MiniMax-M3

# MiniMax M3 API Configuration
# Keep the real key only in .env; never commit it to Git.
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_ENDPOINT=/text/chatcompletion_v2
MINIMAX_MODEL=MiniMax-M3
MINIMAX_TIMEOUT_MS=90000
MINIMAX_MAX_RETRIES=2
MINIMAX_TEMPERATURE=0.2
MINIMAX_MAX_TOKENS=4096
MINIMAX_THINKING=true

# Chrome DevTools Protocol, Browser Choice & Display
THREADS_CDP_URL=http://127.0.0.1:9222
# BROWSER_TYPE: auto (default detected), chrome, edge, brave, or chromium
BROWSER_TYPE=auto
DISPLAY=:1

# Operational Modes
# PLATFORM_TARGET: threads (default), instagram, or all
PLATFORM_TARGET=threads
# APPROVAL_MODE: true (requires human confirmation before posting), false (autonomous posting)
APPROVAL_MODE=true

# DRY_RUN: true (simulates all post/DM submissions without publishing), false (live actions)
DRY_RUN=true

# POSTING_ENABLED: safety master switch for live Threads publishing
POSTING_ENABLED=false

# Rate Limits (Actions per hour)
MAX_NEW_POST_REPLIES_PER_HOUR=5
MAX_TOTAL_REPLIES_PER_HOUR=15
MAX_DM_REPLIES_PER_HOUR=10

# Stealth Delays between actions (milliseconds)
MIN_ACTION_DELAY_MS=15000
MAX_ACTION_DELAY_MS=45000

# Scanner Settings
SCAN_INTERVAL_SECONDS=300
MAX_POSTS_PER_SCAN=50

# Publishing Cadence (6 hours = exactly 4 posts / 24 hours)
POST_INTERVAL_HOURS=6

# ============================================================
# AGENTIC JOB REVENUE ENGINE
# ============================================================
JOB_AUTOMATION_ENABLED=true
JOB_APPLICATION_MODE=auto
JOB_REMOTE_ONLY=true
JOB_PROJECT_ONLY=true

# Dedicated browser/session isolation for job marketplaces
JOB_BROWSER_CDP_URL=http://127.0.0.1:9223
JOB_BROWSER_TYPE=auto
JOB_BROWSER_USER_DATA_DIR=./private/job-browser-profile

# Supply your factual base resume locally; never commit it.
JOB_BASE_RESUME_PATH=./private/base-resume.pdf
JOB_PROFILE_PATH=./private/candidate-profile.json

# Agentic discovery/application controls
JOB_DISCOVERY_INTERVAL_SECONDS=900
JOB_MAX_OPPORTUNITIES_PER_SCAN=100
JOB_MAX_APPLICATIONS_PER_DAY=20
JOB_MIN_MATCH_SCORE=75
JOB_MAX_PLAN_ACTIONS=24
JOB_MAX_SCROLLS=8
JOB_MAX_PLAN_ITERATIONS=8
JOB_NAVIGATION_TIMEOUT_MS=60000
JOB_PAGE_SETTLE_MS=2500

# Platform switches are data/configuration, not browser logic.
JOB_UPWORK_ENABLED=true
JOB_FREELANCER_ENABLED=true
JOB_CONTRA_ENABLED=true
JOB_PEOPLEPERHOUR_ENABLED=true
JOB_GURU_ENABLED=true
JOB_WORKANA_ENABLED=true
JOB_MALT_ENABLED=true
JOB_ARC_ENABLED=true
JOB_TOPTAL_ENABLED=true
JOB_FIVERR_ENABLED=true

GOOGLE_ACCOUNT_EMAIL=sunmughan@gmail.com
