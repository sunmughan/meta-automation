# Threads AI Lead Generation + Engagement Agent
# Configuration Template

# Gemini API Configuration
GEMINI_API_KEY=

# Chrome DevTools Protocol, Browser Choice & Display
THREADS_CDP_URL=http://127.0.0.1:9222
# BROWSER_TYPE: auto (default detected), chrome, edge, brave, or chromium
BROWSER_TYPE=auto
DISPLAY=:1

# Operational Modes
# APPROVAL_MODE: true (requires human confirmation before posting), false (autonomous posting)
APPROVAL_MODE=true

# DRY_RUN: true (simulates all post/DM submissions without publishing), false (live actions)
DRY_RUN=true

# POSTING_ENABLED: safety master switch for live Threads publishing
POSTING_ENABLED=false

# Rate Limits (Actions per hour)
MAX_NEW_POST_REPLIES_PER_HOUR=5
MAX_TOTAL_REPLIES_PER_HOUR=15
MAX_DM_REPLIES_PER_HOUR=10

# Stealth Delays between actions (milliseconds)
MIN_ACTION_DELAY_MS=15000
MAX_ACTION_DELAY_MS=45000

# Scanner Settings
SCAN_INTERVAL_SECONDS=300
MAX_POSTS_PER_SCAN=50
