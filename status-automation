#!/data/data/com.termux/files/usr/bin/env bash
# Reports both Meta Automation workers and their isolated browser CDP sessions.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR" || exit 1

echo "=================================================="
echo "  META AUTOMATION — SYSTEM STATUS"
echo "=================================================="

# Check Active Autopilot Mode
node -e '
const { getActiveMode } = require("./src/core/autopilot-manager");
const active = getActiveMode();
if (active.mode === "social") {
  console.log("  🟢 ACTIVE AUTOPILOT MODE : SOCIAL AUTOPILOT (PID " + active.pid + ")");
} else {
  console.log("  ⚪ ACTIVE AUTOPILOT MODE : NONE (IDLE)");
}
' 2>/dev/null || true
echo "--------------------------------------------------"

show_worker() {
  local name="$1"
  local pid_file="$2"

  if [ -f "$pid_file" ]; then
    local pid
    pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      echo "🟢 $name : RUNNING (PID $pid)"
      return 0
    fi
    rm -f "$pid_file"
  fi

  echo "⚪ $name : NOT RUNNING"
}

show_worker "Social Automation" "$SCRIPT_DIR/threads-agent.pid"

if curl -sf http://127.0.0.1:9222/json/version >/dev/null 2>&1; then
  echo "🟢 Social Browser CDP : ACTIVE (:9222)"
else
  echo "🔴 Social Browser CDP : OFFLINE (:9222)"
fi

echo ""
echo "Social state:"
node threads-agent.js status || true

echo ""
echo "Recent social activity:"
tail -n 10 "$SCRIPT_DIR/logs/daemon.log" 2>/dev/null || true

