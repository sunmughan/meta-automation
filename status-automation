#!/usr/bin/env bash
# Reports both Meta Automation workers and their isolated browser CDP sessions.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR" || exit 1

echo "=================================================="
echo "  META AUTOMATION — SYSTEM STATUS"
echo "=================================================="

show_worker() {
  local name="$1"
  local pid_file="$2"

  if [ -f "$pid_file" ]; then
    local pid
    pid="$(cat "$pid_file" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      echo "🟢 $name : RUNNING (PID $pid)"
      return 0
    fi
    rm -f "$pid_file"
  fi

  echo "⚪ $name : NOT RUNNING"
}

show_worker "Social Automation" "$SCRIPT_DIR/threads-agent.pid"
show_worker "Job Revenue Engine" "$SCRIPT_DIR/job-agent.pid"

if curl -sf http://127.0.0.1:9222/json/version >/dev/null 2>&1; then
  echo "🟢 Social Browser CDP : ACTIVE (:9222)"
else
  echo "🔴 Social Browser CDP : OFFLINE (:9222)"
fi

if curl -sf http://127.0.0.1:9223/json/version >/dev/null 2>&1; then
  echo "🟢 Job Browser CDP    : ACTIVE (:9223)"
else
  echo "🔴 Job Browser CDP    : OFFLINE (:9223)"
fi

echo ""
echo "Social state:"
node threads-agent.js status || true

echo ""
echo "Job state:"
node job-agent.js status || true

echo ""
echo "Recent social activity:"
tail -n 10 "$SCRIPT_DIR/logs/daemon.log" 2>/dev/null || true

echo ""
echo "Recent job activity:"
tail -n 10 "$SCRIPT_DIR/logs/job-daemon.log" 2>/dev/null || true
