#!/data/data/com.termux/files/usr/bin/env bash
# Standalone Meta Automation launcher.
# Starts Social Automation in the browser (CDP :9222).
# No IDE is required.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR" || exit 1
if [ -n "$PREFIX" ] && [[ "$PREFIX" == *"com.termux"* ]]; then
  exec "$SCRIPT_DIR/start-termux" "$@"
fi
exec node "$SCRIPT_DIR/scripts/desktop-runner.js" "$@"
