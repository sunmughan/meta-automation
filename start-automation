#!/usr/bin/env bash
# Standalone Meta Automation launcher.
# Starts Social Automation + Job Revenue Engine in two browser windows:
#   LEFT 50%  -> social browser / CDP :9222
#   RIGHT 50% -> job browser / CDP :9223
# No IDE is required.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR" || exit 1
exec node "$SCRIPT_DIR/scripts/desktop-runner.js" "$@"
