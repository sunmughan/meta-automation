#!/usr/bin/env bash
# start-automation
# Master command to launch CodeAir Threads + Instagram Automation.
# Runs non-stop in the background (or foreground with --foreground)
# Runs independently of any IDE and closing terminal.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR" || exit 1

PID_FILE="$SCRIPT_DIR/threads-agent.pid"
LOG_FILE="$SCRIPT_DIR/logs/daemon.log"
mkdir -p "$SCRIPT_DIR/logs"

echo "=================================================="
echo "  🚀 CODEAIR META AUTOMATION (THREADS FOCUSED)"
echo "=================================================="

# 1. Ensure Browser CDP is running on port 9222 (Chrome, Edge, Brave, Chromium)
echo "[1/3] Verifying Browser CDP on port 9222 (Chrome, Edge, Brave, Chromium)..."
if [ -f "$SCRIPT_DIR/scripts/launch-browser-cdp.js" ]; then
    node "$SCRIPT_DIR/scripts/launch-browser-cdp.js" "$@"
else
    "$SCRIPT_DIR/scripts/launch-brave-cdp.sh" "$@"
fi
if [ $? -ne 0 ]; then
    echo "❌ Failed to establish Browser CDP connection on port 9222."
    exit 1
fi

# 2. Check Authentication
echo "[2/3] Checking platform authentication sessions..."
node threads-agent.js auth > /dev/null 2>&1
if [ $? -eq 0 ]; then
    echo "✅ Authenticated sessions verified for configured platform."
else
    echo "⚠️  Authentication check completed (check 'node threads-agent.js auth' for details)."
fi

# 3. Check if already running
if [ -f "$PID_FILE" ]; then
    EXISTING_PID=$(cat "$PID_FILE" 2>/dev/null)
    if [ -n "$EXISTING_PID" ] && kill -0 "$EXISTING_PID" 2>/dev/null; then
        echo ""
        echo "=================================================="
        echo "  🟢 Automation is ALREADY running (PID: $EXISTING_PID)"
        echo "=================================================="
        echo "Live activity : tail -f $LOG_FILE"
        echo "Check status  : ./status-automation"
        echo "Stop command  : ./stop-automation"
        echo "=================================================="
        exit 0
    fi
    rm -f "$PID_FILE"
fi

# 4. Foreground vs Background
if [ "$1" == "--foreground" ] || [ "$1" == "-f" ]; then
    echo "[3/3] Starting automation loop in FOREGROUND..."
    echo "Press Ctrl+C to stop."
    echo "=================================================="
    node threads-agent.js run
else
    echo "[3/3] Starting automation loop in BACKGROUND..."
    # setsid ensures complete detachment from current session and MiniMax M3 IDE
    setsid nohup node threads-agent.js run >> "$LOG_FILE" 2>&1 &
    AGENT_PID=$!
    disown $AGENT_PID 2>/dev/null
    echo "$AGENT_PID" > "$PID_FILE"

    sleep 2

    if kill -0 "$AGENT_PID" 2>/dev/null; then
        echo ""
        echo "=================================================="
        echo "  ✅ AUTOMATION IS NOW RUNNING NON-STOP"
        echo "=================================================="
        echo "  Process ID    : $AGENT_PID"
        echo "  Status        : ACTIVE IN BACKGROUND"
        echo "  Detached      : YES (Survives closing MiniMax M3 IDE)"
        echo "  Mode          : LIVE (Visual Feed Scrolling, Own Posts, Auto Comments & Replies)"
        echo "  Live Logs     : tail -f $LOG_FILE"
        echo "  Status Command: ./status-automation"
        echo "  Stop Command  : ./stop-automation"
        echo "=================================================="
    else
        echo "❌ Failed to start background daemon. Check $LOG_FILE for details."
        rm -f "$PID_FILE"
        exit 1
    fi
fi
